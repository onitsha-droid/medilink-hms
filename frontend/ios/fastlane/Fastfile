default_platform(:ios)

platform :ios do
  desc "Runs frontend unit and widget tests prior to build"
  lane :test do
    Dir.chdir("../..") do
      sh("flutter", "test")
    end
  end

  desc "Build iOS IPA for Staging distribution"
  lane :staging do
    Dir.chdir("../..") do
      sh("flutter", "build", "ios", "--no-codesign", "--config-only")
    end
    UI.message("Staging iOS artifact configured. App Store publishing is disabled.")
  end

  desc "Build iOS for Beta / TestFlight testing"
  lane :beta do
    Dir.chdir("../..") do
      sh("flutter", "build", "ios", "--no-codesign")
    end
    # upload_to_testflight - DISABLED: store publishing disabled for now
    UI.message("Beta iOS built. TestFlight / App Store publishing is disabled for now.")
  end

  desc "Production release lane — Store publishing is intentionally disabled"
  lane :deploy do
    # Store publishing stays disabled for now
    UI.user_error!("Store publishing is disabled for now per project requirements.")
  end
end
